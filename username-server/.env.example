# MongoDB Atlas connection string example
# Create a cluster at https://cloud.mongodb.com, create a database user, then copy the "Connect your application" URI.
# Replace <username>, <password>, and <dbname> and remove the angle brackets.

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# Example: MONGODB_URI=mongodb+srv://admin:MySecretPass@cluster0.mongodb.net/username-db?retryWrites=true&w=majority

# Other env vars
JWT_SECRET=your_jwt_secret_key_here_change_this
PORT=5000
